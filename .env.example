# ===== AI 제공자 설정 =====
# 기본 제공자: gemini (Google Gemini 무료 등급 권장)
# 다른 무료 제공자로 바꾸려면 groq 로 변경하세요.
AI_PROVIDER=gemini

# (선택) 폴백 체인: 콤마로 여러 제공자를 나열하면, 앞의 것이 막히면(429 등) 다음으로 자동 전환.
# 예) AI_PROVIDERS=groq,openrouter,gemini   (설정 시 AI_PROVIDER보다 우선)
AI_PROVIDERS=

# ★ "무료 AI 사용량이 가득 찼어요" 가 뜬다면 ★
#   설정된 제공자가 전부 소진된 상태입니다. 아래 중 하나로 한도를 늘리세요.
#   1) 키를 여러 개 넣기 — 한도는 키(계정/프로젝트)별로 따로 적용됩니다.
#      GEMINI_API_KEY 에 콤마로 여러 개를 넣거나, GEMINI_API_KEY_2 · _3 … (최대 6개)로 추가.
#      Groq 도 동일: GROQ_API_KEY 콤마 나열 또는 GROQ_API_KEY_2 · _3 …
#   2) 다른 무료 제공자 키를 추가 (Gemini + Groq + Cerebras + OpenRouter 를 모두 넣으면
#      한 곳이 막혀도 자동으로 다음 제공자로 넘어갑니다)
#   3) 유료지만 저렴한 최후 보루로 ANTHROPIC_API_KEY 추가
#   현재 어떤 제공자가 살아있는지는 /api/ai-health 로 확인할 수 있습니다.

# --- Google Gemini (무료 등급) ---
# https://aistudio.google.com/apikey 에서 무료로 API 키 발급
# 일일 한도가 커서 가장 강력한 폴백. 여러 개 넣으면 그만큼 한도가 늘어납니다.
GEMINI_API_KEY=
# (선택) 키 추가 — 콤마 나열도 가능하고 아래처럼 번호로 나눠도 됩니다(_2 ~ _6).
GEMINI_API_KEY_2=
# 기본: gemini-2.0-flash
# Gemma 를 쓰려면 같은 키로 GEMINI_MODEL=gemma-3-27b-it (또는 gemma-3-12b-it 등) 지정
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (무료 등급, 선택) ---
# https://console.groq.com/keys 에서 무료로 API 키 발급
# 한도(TPD)가 "모델별"로 따로 적용되어, 주력 모델이 막히면 작은 모델로 자동 전환됩니다.
GROQ_API_KEY=
# (선택) 키 추가 (_2 ~ _6)
GROQ_API_KEY_2=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cerebras (무료 등급, 선택) ---
# https://cloud.cerebras.ai 에서 무료 키 발급. 70b급 모델에 일 100만 토큰대로 한도가 넉넉해
# Groq 소형 모델보다 먼저 폴백 체인에 들어갑니다.
CEREBRAS_API_KEY=

# --- OpenRouter (무료로 Gemma 사용, 선택) ---
# AI_PROVIDER=openrouter 로 설정하면 OpenRouter 의 무료 Gemma 를 사용합니다.
# https://openrouter.ai/keys 에서 무료 키 발급 (sk-or-... 형식)
OPENROUTER_API_KEY=
# 무료 모델 목록: https://openrouter.ai/models (예: google/gemma-2-9b-it:free)
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# --- Anthropic Claude (유료, 최후 보루 / 선택) ---
# 무료 제공자가 모두 소진돼도 앱이 멈추지 않게 하는 마지막 폴백. 체인 맨 뒤에 붙습니다.
# https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=

# --- 로컬 Ollama (내 PC에서 Gemma 실행, 키 불필요) ---
# AI_PROVIDER=ollama 로 설정. ※ 로컬 실행(npm run dev)에서만 동작, 공개 주소 X
# Ollama 설치: https://ollama.com  /  모델 받기: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ===== 학습 랭킹(로그인/경쟁) 설정 =====
# 무료 Upstash Redis. Vercel → Storage 에서 Upstash 연결 시 아래 2개가 자동 주입됩니다.
# (직접 쓰려면 https://upstash.com 에서 DB 생성 후 REST URL/TOKEN 복사)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 세션 토큰 서명용 비밀키 (아무 긴 랜덤 문자열로 지정)
AUTH_SECRET=
